FACTORY_DESK_SLACK_BOT_TOKEN=
FACTORY_DESK_SLACK_APP_TOKEN=
# Jira project file_ticket creates in. Overrides FACTORY_JIRA_PROJECTS when
# set, even to empty. Unset, with FACTORY_JIRA_PROJECTS unset: file_ticket
# refuses and names both variables. Never a production project.
FACTORY_DESK_JIRA_PROJECT=TLSSN
# Shared list. The desk creates in the first key when FACTORY_DESK_JIRA_PROJECT
# is unset, and the Jira channel ignores status changes on any other project.
# Empty: every project's status changes are announced.
FACTORY_JIRA_PROJECTS=TLSSN
# Shared owner/repo list. The desk's read-only GitHub channel posts review
# updates (Bugbot, security review, CI, autofix) for factory PRs here only.
# Deploy the desk with --cursor-events-repo for the same repository.
FACTORY_REPOS=cursor-demo-lab/marsbank
# Slack channel id (C...) the announce tools post to when a ticket was filed
# in Jira directly and so has no thread. Unset: such tickets are not
# announced; the plan and the agent link are still on the ticket.
# Demo value: #mars-eng-intake. Channel ids are not secret.
# Same id is the channelPosts allowlist in agent/channels/slack.ts
# (posts: "all") so a bare thread reply wakes the desk.
FACTORY_DESK_INTAKE_CHANNEL=<SLACK_CHANNEL_ID>
# Kill switch, read per wake: off puts back the plain read-then-put
# review-recheck/<pr>/<sha> record in place of the owner lease. Unset: lease.
# FACTORY_DESK_RECHECK_LEASE=off
# Slack mention users type in plan posts and ask copy. Defaults to @factory.
FACTORY_DESK_SLACK_HANDLE=@factory
# HMAC secret of this slug's Jira webhook on /v1/channels/jira. Each slug has
# its own; the values may match. Unset: every Jira delivery is refused (401).
JIRA_WEBHOOK_SECRET=
# HMAC secret for Linear deliveries (Linear-Signature) on the same route.
# Unset: every Linear delivery is refused (401).
LINEAR_WEBHOOK_SECRET=
# Site the Atlassian MCP tools take as cloudId (the site URL or its cloud id).
# Unset: https://<JIRA_SITE>.atlassian.net.
JIRA_CLOUD_ID=
# TypeSafe key for the host-side Jev judge on a Slack filing request (Jira
# issue type, severity, needs-info gate). Every answer above 0.55: the ticket
# is filed with Jev's triage. Unset, Jev down, or at or under 0.55: the desk's
# own filing turn triages it. Hosted: set it as the slug's TYPESAFE_API_KEY
# secret (agent/extensions/jev.ts expects it and allowlists api.typesafe.ai).
TYPESAFE_API_KEY=
# Host model. Unset: grok-4.6 with effort high and fast=true (grok-4.6-fast)
# for every desk turn: the filing prompt, its fallback triage, commands, and
# status answers. FACTORY_AGENT_MODEL=auto-smart runs them on Auto
# (optimize_for=balanced). FACTORY_AGENT_MODEL=grok-4.7 defaults to effort high and
# speed fast. Effort and speed are params, never an id suffix.
FACTORY_AGENT_MODEL=
FACTORY_AGENT_EFFORT=
FACTORY_AGENT_SPEED=
# Workflow status names. Set these when the Jira workflow names differ.
# request_plan bounces a ticket already in Triaged through FACTORY_STATUS_TODO.
FACTORY_STATUS_TODO="To Do"
FACTORY_STATUS_TRIAGED=Triaged
FACTORY_STATUS_PLANNED=Planned
FACTORY_STATUS_APPROVED=Approved
FACTORY_STATUS_IN_PROGRESS="In Progress"
# Only rank the intake root's status line; the desk posts nothing on them.
FACTORY_STATUS_IN_REVIEW="In Review"
FACTORY_STATUS_DONE=Done
# Stage. Unset, production, or prod: a live slug. Any other value (staging)
# is a staging slug that refuses the production Slack intake, Jira project,
# and sandbox repository (agent/lib/factory-stage.ts) unless
# FACTORY_STAGING_ALLOW_PRODUCTION names them, comma-separated.
FACTORY_ENV=
FACTORY_STAGING_ALLOW_PRODUCTION=
# The hop-watch/index merge (kv-index.ts), read per request. Hosted kv has
# no compare-and-set, so index writes are verified merges. off: the plain
# read-then-put add and prune from before the merge, with no self-heal.
# Anything else, or unset: the merge.
FACTORY_INDEX_MERGE=
# KV retry pauses (kv-verified.ts), read per call: a comma list of
# milliseconds (sum at most 500) waited before the second and later
# attempts of a failed kv call. Unset: 100,400 with jitter. Empty or off:
# no pauses, retries unchanged. Only 429, 5xx and network errors retry.
FACTORY_KV_RETRY_PAUSES_MS=
# Ops failure funnel (agent/lib/ops-funnel.ts), optional. A kv failure the
# code swallows logs one {"kv":"warn"} line either way. With both set, an
# unexpected kv or claim failure also posts one line per site and reason per
# hour to FACTORY_OPS_SLACK_CHANNEL (a C... id) as the separate chat:write-only
# ops bot, never the desk's token. Either unset: no post. FACTORY_OPS_FUNNEL=off
# turns the posts off.
FACTORY_OPS_SLACK_BOT_TOKEN=
FACTORY_OPS_SLACK_CHANNEL=
FACTORY_OPS_FUNNEL=

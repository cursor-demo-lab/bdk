# Absolute path of a local clone of the sandbox named by FACTORY_SANDBOX_REPO.
# Set: every planner session reads that checkout with read/grep/glob/ls.
# Unset: search_sandbox reads the GitHub tree instead. Never point this at a
# production checkout.
FACTORY_PLANNER_CHECKOUT=
# Repository named in the implementation brief and searched when there is no
# checkout. Unset: the first FACTORY_REPOS entry.
FACTORY_SANDBOX_REPO=cursor-demo-lab/marsbank
# Branch or ref of the sandbox the planner reads. Unset: main.
FACTORY_SANDBOX_REF=main
FACTORY_REPOS=cursor-demo-lab/marsbank
# Optional local/dev override for the sandbox tree when there is no checkout
# and cursorAccount pass-through is not bound. Hosted factory-planner uses
# githubChannel({ cursorAccount }) / ctx.host.github instead; leave unset.
FACTORY_GITHUB_TOKEN=
# Jira projects the planner may comment on and the webhook plans. Overrides
# FACTORY_JIRA_PROJECTS when set, even to empty. Unset, with
# FACTORY_JIRA_PROJECTS unset: the comment is refused and the message names
# both variables.
FACTORY_PLANNER_JIRA_PROJECTS=TLSSN
FACTORY_JIRA_PROJECTS=TLSSN
# HMAC secret of this slug's Jira webhook on /v1/channels/webhook. Each slug has
# its own; the values may match. Unset: every Jira delivery is refused (401).
JIRA_WEBHOOK_SECRET=
# HMAC secret for Linear deliveries (Linear-Signature) on the same route.
# Unset: every Linear delivery is refused (401).
LINEAR_WEBHOOK_SECRET=
# Site the Atlassian MCP tools take as cloudId (the site URL or its cloud id).
# Unset: https://<JIRA_SITE>.atlassian.net.
JIRA_CLOUD_ID=
# Jira status names. The webhook plans a ticket that enters
# FACTORY_STATUS_TRIAGED (a move from FACTORY_STATUS_PLANNED is a replan).
# record_plan moves a chained ticket to FACTORY_STATUS_PLANNED, or, when its
# Plan: comment is already there, only while the ticket is still
# FACTORY_STATUS_TRIAGED. Unset: Triaged, Planned.
FACTORY_STATUS_TRIAGED=
FACTORY_STATUS_PLANNED=
# The plan/ and plan-claimed/ claims (verified-claim.ts), read per
# request. Hosted kv has no compare-and-set, so a claim puts an owner, reads
# it back, waits this long, and reads again before it acts. Unset: 2000. 0
# skips the wait and the re-read; above 10000 or unparseable keeps 2000.
FACTORY_CLAIM_SETTLE_MS=
# legacy: the plain read-then-put claim and plain delete from before the
# owner claim, exactly. Anything else, or unset: the owner claim.
FACTORY_CLAIM_MODE=
# Host model. Unset: Auto (auto-smart, optimize_for=balanced), which takes
# no effort or speed. FACTORY_AGENT_MODEL=grok-4.7 defaults to effort high and
# speed fast. Effort and speed are params, never an id suffix.
FACTORY_AGENT_MODEL=
FACTORY_AGENT_EFFORT=
FACTORY_AGENT_SPEED=
# Stage. Unset, production, or prod: a live slug. Any other value (staging)
# is a staging slug that refuses the production Slack intake, Jira project,
# and sandbox repository (agent/lib/factory-stage.ts) unless
# FACTORY_STAGING_ALLOW_PRODUCTION names them, comma-separated.
FACTORY_ENV=
FACTORY_STAGING_ALLOW_PRODUCTION=
# KV retry pauses (kv-verified.ts), read per call: a comma list of
# milliseconds (sum at most 500) waited before the second and later
# attempts of a failed kv call. Unset: 100,400 with jitter. Empty or off:
# no pauses, retries unchanged. Only 429, 5xx and network errors retry.
FACTORY_KV_RETRY_PAUSES_MS=
# Ops failure funnel (agent/lib/ops-funnel.ts), optional. A kv failure the
# code swallows logs one {"kv":"warn"} line either way. With both set, an
# unexpected kv or claim failure also posts one line per site and reason per
# hour to FACTORY_OPS_SLACK_CHANNEL (a C... id) as the separate chat:write-only
# ops bot, never the desk's token. Either unset: no post. FACTORY_OPS_FUNNEL=off
# turns the posts off.
FACTORY_OPS_SLACK_BOT_TOKEN=
FACTORY_OPS_SLACK_CHANNEL=
FACTORY_OPS_FUNNEL=

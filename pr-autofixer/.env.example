# Repositories this project may drive. PR_AUTOFIXER_REPOS overrides
# FACTORY_REPOS when set, even to empty. Both unset, or the override set but
# empty: the channel still boots with no repositories, and a drive fails with
# an error naming both variables.
# PR_AUTOFIXER_REPOS=owner/other
FACTORY_REPOS=cursor-demo-lab/marsbank
# Jira projects that mark a factory pull request.
# PR_AUTOFIXER_AUTO_DRIVE_PROJECTS overrides FACTORY_JIRA_PROJECTS when set,
# even to empty. Empty, or both unset: no automatic drive.
# PR_AUTOFIXER_AUTO_DRIVE_PROJECTS=
FACTORY_JIRA_PROJECTS=TLSSN
# Host model. Unset: Auto (auto-smart, optimize_for=balanced), which takes
# no effort or speed. FACTORY_AGENT_MODEL=grok-4.7 defaults to effort high and
# speed fast. Effort and speed are params, never an id suffix.
FACTORY_AGENT_MODEL=
FACTORY_AGENT_EFFORT=
FACTORY_AGENT_SPEED=
# Stage. Unset, production, or prod: a live slug. Any other value (staging)
# is a staging slug that refuses the production Slack intake, Jira project,
# and sandbox repository (agent/lib/factory-stage.ts) unless
# FACTORY_STAGING_ALLOW_PRODUCTION names them, comma-separated.
FACTORY_ENV=
FACTORY_STAGING_ALLOW_PRODUCTION=
# KV retry pauses (kv-verified.ts), read per call: a comma list of
# milliseconds (sum at most 500) waited before the second and later
# attempts of a failed kv call. Unset: 100,400 with jitter. Empty or off:
# no pauses, retries unchanged. Only 429, 5xx and network errors retry.
FACTORY_KV_RETRY_PAUSES_MS=
# KV Phase 1 K8 kill switches, read per request.
# The drive claim's settle before it re-reads itself: whole ms, 0 to 2000.
# Unset or anything else: 2000. 0: no settle, the claim as before K8.
FACTORY_FIXER_CLAIM_SETTLE_MS=
# off: a closed PR releases its drive claim only (and a kv failure fails the
# delivery), keeping affinity and Bugbot rounds across a reopen.
FACTORY_FIXER_CLOSE_CLEANUP=
# off: Bugbot rounds and the cap note are plain read-then-put writes.
FACTORY_FIXER_ROUNDS_MERGE=
# Ops failure funnel (agent/lib/ops-funnel.ts), optional. A kv failure the
# code swallows logs one {"kv":"warn"} line either way. With both set, an
# unexpected kv or claim failure also posts one line per site and reason per
# hour to FACTORY_OPS_SLACK_CHANNEL (a C... id) as the separate chat:write-only
# ops bot, never the desk's token. Either unset: no post. FACTORY_OPS_FUNNEL=off
# turns the posts off.
FACTORY_OPS_SLACK_BOT_TOKEN=
FACTORY_OPS_SLACK_CHANNEL=
FACTORY_OPS_FUNNEL=

# Shared scope for every project in this factory. A project variable, where
# one exists, overrides the shared variable. Unset means refuse. The values
# below are this deployment's examples, not defaults in code.

# Comma-separated owner/repo. security-reviewer reviews these pull requests.
# pr-autofixer may drive them. factory-desk may mount the first, unless
# FACTORY_SANDBOX_REPO is set.
FACTORY_REPOS=cursor-demo-lab/marsbank

# One owner/repo for the factory-desk cloud mount and the planner brief.
# Unset: the first FACTORY_REPOS entry.
FACTORY_SANDBOX_REPO=cursor-demo-lab/marsbank

# Git ref for the factory-desk cloud mount and the planner's GitHub tree.
# Unset: main.
FACTORY_SANDBOX_REF=main

# Optional local/dev override so factory-planner can search
# FACTORY_SANDBOX_REPO when FACTORY_PLANNER_CHECKOUT is unset and
# cursorAccount pass-through is not bound. Hosted factory-planner leaves
# this unset and uses githubChannel({ cursorAccount }) / ctx.host.github.
FACTORY_GITHUB_TOKEN=

# Comma-separated Jira project keys. factory-desk creates in the first.
# planner writes to any listed. pr-autofixer treats a pull request as its
# own when the branch or title starts with a listed key.
FACTORY_JIRA_PROJECTS=TLSSN

# Local `serve --dir .` only. Unset on hosted v2 (one slug per app, no
# in-process neighbors). Set to 1 so desk, planner, and triage-jira keep
# their `{ agent }` peers. See docs/deployment-issues.md.
FACTORY_INPROCESS_PEERS=1

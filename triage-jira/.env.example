# This project does not read FACTORY_REPOS. It reads FACTORY_JIRA_PROJECTS
# only when FACTORY_ENV is staging: then it triages and writes only full keys
# of those projects (agent/lib/staging-issue.ts). Production triages whatever
# its own signed rule delivers, whatever this is set to.
FACTORY_JIRA_PROJECTS=
# HMAC secret of this slug's Jira webhook on /v1/channels/webhook. Each slug has
# its own; the values may match. Unset: every Jira delivery is refused (401).
JIRA_WEBHOOK_SECRET=
# HMAC secret for Linear deliveries (Linear-Signature) on the same route.
# Unset: every Linear delivery is refused (401).
LINEAR_WEBHOOK_SECRET=
# Site the Atlassian MCP tools take as cloudId (the site URL or its cloud id).
# Unset: https://<JIRA_SITE>.atlassian.net.
JIRA_CLOUD_ID=
# TypeSafe key for the host-side Jev judge in record_triage (Jira issue
# type and severity as Choices; a confident type is written to the ticket).
# Unset: no Jev call; the model's verdict is recorded as before. Hosted: set
# it as the slug's TYPESAFE_API_KEY secret.
TYPESAFE_API_KEY=
# Host model. Unset: grok-4.6 with effort high and fast=true (grok-4.6-fast),
# because this agent's only model turn is the fallback triage turn when Jev
# does not settle the ticket. FACTORY_AGENT_MODEL=auto-smart runs it on Auto
# (optimize_for=balanced). FACTORY_AGENT_MODEL=grok-4.7 defaults to effort high and
# speed fast. Effort and speed are params, never an id suffix.
FACTORY_AGENT_MODEL=
FACTORY_AGENT_EFFORT=
FACTORY_AGENT_SPEED=
# Jira status names. record_triage moves a freshly triaged ticket to
# FACTORY_STATUS_TRIAGED, which wakes the planner. A redelivery that finds its
# Triage: comment moves the ticket only while it is still in
# FACTORY_STATUS_TODO. The wake skips a ticket created in To Do that is
# already in any later status when it reads it back. Unset: To Do, Triaged,
# Planned, Approved, In Progress, In Review, Done.
FACTORY_STATUS_TODO=
FACTORY_STATUS_TRIAGED=
FACTORY_STATUS_PLANNED=
FACTORY_STATUS_APPROVED=
FACTORY_STATUS_IN_PROGRESS=
FACTORY_STATUS_IN_REVIEW=
FACTORY_STATUS_DONE=
# Stage. Unset, production, or prod: a live slug. Any other value (staging)
# is a staging slug that refuses the production Slack intake, Jira project,
# and sandbox repository (agent/lib/factory-stage.ts) unless
# FACTORY_STAGING_ALLOW_PRODUCTION names them, comma-separated.
FACTORY_ENV=
FACTORY_STAGING_ALLOW_PRODUCTION=
# Ops failure funnel (agent/lib/ops-funnel.ts), optional. A kv failure the
# code swallows logs one {"kv":"warn"} line either way. With both set, an
# unexpected kv or claim failure also posts one line per site and reason per
# hour to FACTORY_OPS_SLACK_CHANNEL (a C... id) as the separate chat:write-only
# ops bot, never the desk's token. Either unset: no post. FACTORY_OPS_FUNNEL=off
# turns the posts off.
FACTORY_OPS_SLACK_BOT_TOKEN=
FACTORY_OPS_SLACK_CHANNEL=
FACTORY_OPS_FUNNEL=

# The one repository the cloud agent works in (owner/repo). Required.
FACTORY_SANDBOX_REPO=
# Branch or ref the cloud agent starts from. Unset: main.
FACTORY_SANDBOX_REF=
# Jira project keys the worker acts on, comma-separated. Unset: every delivery is refused.
FACTORY_JIRA_PROJECTS=
# HMAC secret of this slug's Jira webhook on /v1/channels/jira. Each slug has
# its own; the values may match. Unset: every Jira delivery is refused (401).
JIRA_WEBHOOK_SECRET=
# Site the Atlassian MCP tools take as cloudId (the site URL or its cloud id).
# Unset: https://example.atlassian.net.
JIRA_CLOUD_ID=
# Implement agent model id. Unset: claude-opus-5-5. The launch API needs a
# full catalog variant (id plus context, effort, fast); see
# Cursor.models.list(). This is also the worker's July root model
# (agent/agent.ts): a live July send carries no modelConfig, so the implement
# cloud turn runs the agent's model. The worker reads no FACTORY_AGENT_*.
# Read once when the process starts (lib/config.ts IMPLEMENT_MODEL), so both
# launch paths use one variant. Local serve only: hosted v2 binds secrets per
# request, after agent.ts has loaded, so these are not hosted secrets and the
# hosted worker always runs the default variant.
FACTORY_WORKER_MODEL=
# Context window: 300k or 1m. Unset: 300k.
FACTORY_WORKER_CONTEXT=
# Cloud agent effort: low, medium, high, xhigh, or max. Unset: high.
FACTORY_WORKER_EFFORT=
# Fast mode: true or false. Unset: false.
FACTORY_WORKER_FAST=
# Earlier factory statuses a person's merge re-syncs from, through In Review to Done. Unset: To Do, Triaged, Planned.
FACTORY_STATUS_TODO=
FACTORY_STATUS_TRIAGED=
FACTORY_STATUS_PLANNED=
# Jira status that triggers a launch. Unset: Approved.
FACTORY_STATUS_APPROVED=
# Jira status the ticket moves to after the launch. Unset: In Progress.
FACTORY_STATUS_IN_PROGRESS=
# Jira status the ticket moves to when its implement PR opens (from In Progress only). Unset: In Review.
FACTORY_STATUS_IN_REVIEW=
# Jira status the ticket moves to when a person merges that PR (through In Review from any earlier factory status). Unset: Done.
FACTORY_STATUS_DONE=
# The implement/<KEY> and pr-status/ claims (verified-claim.ts), read per
# request. Hosted kv has no compare-and-set, so a claim puts an owner, reads
# it back, waits this long, and reads again before it acts. Unset: 2000. 0
# skips the wait and the re-read; above 10000 or unparseable keeps 2000.
FACTORY_CLAIM_SETTLE_MS=
# legacy: the plain read-then-put claim and plain delete from before the
# owner claim, exactly. Anything else, or unset: the owner claim.
FACTORY_CLAIM_MODE=
# Stage. Unset, production, or prod: a live slug. Any other value (staging)
# is a staging slug that refuses the production Slack intake, Jira project,
# and sandbox repository (agent/lib/factory-stage.ts) unless
# FACTORY_STAGING_ALLOW_PRODUCTION names them, comma-separated.
FACTORY_ENV=
FACTORY_STAGING_ALLOW_PRODUCTION=
# The implement-pr-watch/index merge (kv-index.ts), read per request. Hosted kv has
# no compare-and-set, so index writes are verified merges. off: the plain
# read-then-put add and prune from before the merge, with no self-heal.
# Anything else, or unset: the merge.
FACTORY_INDEX_MERGE=
# KV retry pauses (kv-verified.ts), read per call: a comma list of
# milliseconds (sum at most 500) waited before the second and later
# attempts of a failed kv call. Unset: 100,400 with jitter. Empty or off:
# no pauses, retries unchanged. Only 429, 5xx and network errors retry.
FACTORY_KV_RETRY_PAUSES_MS=
# Ops failure funnel (agent/lib/ops-funnel.ts), optional. A kv failure the
# code swallows logs one {"kv":"warn"} line either way. With both set, an
# unexpected kv or claim failure also posts one line per site and reason per
# hour to FACTORY_OPS_SLACK_CHANNEL (a C... id) as the separate chat:write-only
# ops bot, never the desk's token. Either unset: no post. FACTORY_OPS_FUNNEL=off
# turns the posts off.
FACTORY_OPS_SLACK_BOT_TOKEN=
FACTORY_OPS_SLACK_CHANNEL=
FACTORY_OPS_FUNNEL=

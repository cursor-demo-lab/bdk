{
  "name": "factory-desk",
  "private": true,
  "type": "module",
  "description": "agent project: factory-desk",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "agent-sdk dev",
    "start": "agent-sdk serve --dir . --dev",
    "test": "tsx --test \"agent/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "validate": "node --env-file-if-exists=.env.local --env-file-if-exists=../.env.local node_modules/@cursor/july/dist/bin/agent-serve.js validate --dir .",
    "eval:jev-triage": "node --env-file-if-exists=.env.local --env-file-if-exists=../.env.local --import tsx evals/jev-triage/run.ts"
  },
  "dependencies": {
    "@cursor/july": "0.2.22",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.208.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.208.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.208.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.208.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.208.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cursor/sdk": "1.0.37",
    "@types/node": "^22.14.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/core": "^2.11.0",
    "js-yaml": "^4.3.2",
    "undici": "^6.28.0"
  }
}

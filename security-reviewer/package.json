{
  "name": "security-reviewer",
  "private": true,
  "type": "module",
  "description": "Reviews pull requests for exploitable security bugs.",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "agent-sdk dev",
    "start": "agent-sdk serve --dir . --dev",
    "test": "tsx --test \"agent/**/*.test.ts\"",
    "validate": "node --env-file-if-exists=.env.local --env-file-if-exists=../.env.local node_modules/@cursor/july/dist/bin/agent-serve.js validate --dir ."
  },
  "dependencies": {
    "@cursor/july": "0.2.25",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.208.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3"
  },
  "cursorAgentTemplate": "security-reviewer",
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/core": "^2.11.0",
    "js-yaml": "^4.3.2",
    "undici": "^6.28.0"
  }
}
